---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Footer from "@components/Footer.astro";
import Nav from "@components/Nav.astro";
import NavMenu from "@components/NavMenu.astro";
import NavMenuDesktop from "@components/NavMenuDesktop.astro";
import { getMenuPrimary } from "../adapters";
import type { ContentSourceStatus } from "../adapters";
import type { WordPressConnectionStatus } from "../adapters";

type Props = {
  title?: string;
  description?: string;
  /** Ruta o URL de la imagen para compartir. Por defecto la portada del sitio. */
  image?: string;
  contentSources?: ContentSourceStatus[];
  wordpressStatus?: WordPressConnectionStatus;
};

// Titulos y descripciones se miden en pixeles, no en caracteres, pero como regla
// practica Google corta el titulo cerca de los 60 caracteres y la descripcion
// cerca de los 160: pasarse no penaliza, solo trunca la frase a media palabra.
// La marca es "La Paz Sí Pasa" y la entidad "Fondo Colombia en Paz"; el titulo de
// portada lleva las dos porque la busqueda por el nombre de la entidad es la
// que trae trafico.
const siteName = "La Paz Sí Pasa";
const title = Astro.props.title
  ? `${Astro.props.title} | ${siteName}`
  : `${siteName} | Fondo Colombia en Paz`;
const description = Astro.props.description
  ?? "El Fondo Colombia en Paz ejecuta los recursos para implementar la paz: conoce las "
     + "subcuentas, las cifras de gestión y las historias de los territorios PDET.";

// Astro.site sale de PUBLIC_SITE_URL y se hornea en el build. Si falta, se cae a
// la URL de la petición para no emitir enlaces canónicos ni og:image relativos,
// que las redes sociales descartan.
const base = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, base);
const ogImage = new URL(Astro.props.image ?? "/og.jpg", base);

// El menú se obtiene una sola vez aquí y se pasa a las dos variantes de Nav.
const debugParam = Astro.url.searchParams.get("debug-content");
const contentDebugEnabled = debugParam === "1" || (import.meta.env.DEV && debugParam !== "0");
let menuSource: ContentSourceStatus["source"] = "mocks";
const menuItems = await getMenuPrimary(
  contentDebugEnabled ? (status) => { menuSource = status.source; } : undefined,
);

const contentSources = [
  ...(Astro.props.contentSources ?? []),
  ...(contentDebugEnabled
    ? [
        { content: "NavMenu.astro", source: menuSource },
        { content: "NavMenuDesktop.astro", source: menuSource },
      ]
    : []),
];
const wordpressStatus = Astro.props.wordpressStatus;
const wordpressLabel = wordpressStatus?.url.startsWith("http://localhost:")
  ? "WordPress local"
  : "WordPress";
const showContentDebug = contentSources.length > 0 || Boolean(wordpressStatus);
const debugOffUrl = new URL(Astro.url);
if (import.meta.env.DEV) debugOffUrl.searchParams.set("debug-content", "0");
else debugOffUrl.searchParams.delete("debug-content");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {!Astro.props.image && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="La Paz Sí Pasa, pasa en los territorios" />
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <ClientRouter />
  </head>
  <body>
    <Nav siteName={siteName} />
    <NavMenu items={menuItems} />
    <slot name="hero" />
    <NavMenuDesktop items={menuItems} />
    <main>
      <slot />
    </main>
    <Footer />
    {showContentDebug && (
      <aside class="content-debug" aria-label="Fuentes de contenido">
        <strong>Fuentes de contenido</strong>
        {wordpressStatus && (
          <p class:list={["content-debug__connection", { "content-debug__connection--online": wordpressStatus.online }] }>
            <span aria-hidden="true"></span>
            {wordpressLabel}: {wordpressStatus.online ? "arriba" : "abajo"}
            <small>{wordpressStatus.url}</small>
          </p>
        )}
        <ul>
          {contentSources.map(({ content, source }) => (
            <li class:list={[`content-debug__source--${source}`]}>
              <span aria-hidden="true"></span>
              {content}: {source === "wordpress" ? "WordPress" : source === "mocks" ? "Mocks" : "Código"}
            </li>
          ))}
        </ul>
        <a href={`${debugOffUrl.pathname}${debugOffUrl.search}`}>Apagar depurador</a>
      </aside>
    )}
    {showContentDebug && (
      <script is:inline define:vars={{ contentSources, wordpressStatus }}>
        console.groupCollapsed("[content-debug] Fuentes de contenido");
        if (wordpressStatus) {
          const label = wordpressStatus.url.startsWith("http://localhost:") ? "WordPress local" : "WordPress";
          const message = `[content-debug] ${label} ${wordpressStatus.online ? "arriba" : "abajo"}: ${wordpressStatus.url}`;
          wordpressStatus.online ? console.info(message) : console.error(message);
        }
        for (const { content, source } of contentSources) {
          const label = source === "wordpress" ? "WordPress" : source === "mocks" ? "Mocks" : "Código";
          const message = `[content-debug] ${content}: ${label}`;
          source === "mocks" ? console.warn(message) : console.info(message);
        }
        console.groupEnd();
      </script>
    )}
  </body>
</html>

<style>
  .content-debug {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 9999;
    padding: 0.75rem 1rem;
    border: 1px solid #fff3;
    border-radius: 0.5rem;
    background: #171717;
    color: white;
    font: 0.8rem/1.5 ui-monospace, monospace;
    box-shadow: 0 0.5rem 1.5rem #0005;
    max-height: calc(100vh - 2rem);
    overflow: auto;
  }

  .content-debug__connection {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0 0.5rem;
    margin: 0.4rem 0 0;
  }

  .content-debug__connection small {
    grid-column: 2;
    color: #d1d5db;
  }

  .content-debug ul {
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .content-debug li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .content-debug li span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #f59e0b;
  }

  .content-debug__source--wordpress span {
    background: #22c55e;
  }

  .content-debug__source--code span {
    background: #60a5fa;
  }

  .content-debug__connection span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #ef4444;
  }

  .content-debug__connection--online span {
    background: #22c55e;
  }

  .content-debug a {
    display: block;
    margin-top: 0.5rem;
    color: #fff;
    text-decoration: underline;
  }
</style>
