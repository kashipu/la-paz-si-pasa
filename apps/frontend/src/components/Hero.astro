---
import type { HeroData } from "../adapters";
import heroLogo from "../assets/hero/hero-logo.svg";

type Props = { hero?: HeroData };
const { hero } = Astro.props;

// Sin imagen en WordPress se usan los JPEG de public/hero/, pregenerados por
// scripts/optimize-assets.mjs. Este es el elemento LCP y a proposito no pasa por
// astro:assets: con output:"server" cada request pagaria una transformacion de
// sharp sin cache. Como archivo estatico se sirve directo.
// El logo no es editable: siempre sale de assets.
const imagenWp = hero?.imageUrl;
---

<section class="hero">
  {imagenWp
    ? <img src={imagenWp} alt={hero?.imageAlt ?? ""} class="hero__bg" loading="eager" fetchpriority="high" />
    : <img
        src="/hero/hero-1200.jpg"
        srcset="/hero/hero-640.jpg 640w, /hero/hero-960.jpg 960w, /hero/hero-1200.jpg 1200w"
        sizes="100vw"
        width="1200"
        height="800"
        alt=""
        class="hero__bg"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />}
  <a href="/" class="hero__logo-link" aria-label="Ir al inicio">
    <img src={heroLogo.src} alt="La Paz Sí Pasa" class="hero__logo" width="420" />
  </a>
</section>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 60vh;
    overflow: hidden;
    width: 100%;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-height: 70vh;
    object-fit: cover;
    z-index: -1;
  }

  .hero__logo-link {
    display: block;
    width: 100%;
    max-width: 960px;
  }

  .hero__logo {
    width: 100%;
    max-width: 960px;
    padding-inline: 24px;
    height: auto;
    filter: drop-shadow(0 6px 24px rgb(0 0 0 / 85%));
  }

  /* =========================================
     BREAKPOINT 850px
     ========================================= */
  @media (max-width: 849px) {
    .hero__logo {
      padding-inline: 16px;
    }
  }

  /* =========================================
     BREAKPOINT 360px
     ========================================= */
</style>
