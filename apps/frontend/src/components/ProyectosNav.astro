---
// ProyectosNav.astro
---

<nav class="proyectos-nav" aria-label="Navegación de proyectos">
  <ul class="nav-list">
    <li>
      <a href="#" class="btn-project btn-blue">PAISSANA</a>
    </li>
    <li>
      <a href="#" class="btn-project btn-green">PROGRAMA COLOMBIA SOSTENIBLE</a>
    </li>
    <li>
      <a href="#" class="btn-project btn-orange"
        >PROGRAMA PILOTO DE INVERSIONES PRIORITARIAS</a
      >
    </li>
  </ul>
</nav>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  .proyectos-nav {
    display: flex;
    justify-content: flex-start;
    padding: var(--space-4) 0;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .nav-list li {
    display: flex;
    flex: 1;
  }

  .btn-project {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-6);
    color: white;
    font-family: var(--font-monique-regular);
    font-weight: 400;
    font-size: 0.875rem;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.5px;
    height: 100%;
    width: 100%;
    min-height: 48px;
    text-align: center;
    transition: opacity 0.2s;
  }

  .btn-project:hover {
    opacity: 0.9;
  }

  .btn-blue {
    background-color: var(--color-nav-border, #32509d);
  }

  .btn-green {
    background-color: var(--color-loquehacemos-bg, #008861);
  }

  .btn-orange {
    background-color: #eb7b00; /* Color naranja basado en el diseño */
  }

  /* =========================================
     BREAKPOINT 850px
     ========================================= */
  @media (min-width: 850px) {
    .nav-list {
      flex-direction: row;
      gap: 2rem;
    }
  }

  /* =========================================
     BREAKPOINT 360px
     ========================================= */
  @media (max-width: 360px) {
    .btn-project {
      padding-inline: var(--space-3, 12px);
    }
  }
</style>
