---
import { getImage } from "astro:assets";
import noticiasBanner from "../assets/hacemos/noticias-banner@3x.png";

type Props = {
  imageAlt?: string;
  href?: string;
};

// La URL viene del campo noticias_cta_url de la página "home" en WordPress.
// ponytail: "#" mientras ese campo esté vacío — quitar cuando la URL final esté publicada.
const { imageAlt = "Más noticias del fondo aquí", href: hrefProp } = Astro.props;
const href = hrefProp || "#";
const [desktop, tablet, mobile] = await Promise.all([
  getImage({ src: noticiasBanner, width: 1440, format: "webp" }),
  getImage({ src: noticiasBanner, width: 960, format: "webp" }),
  getImage({ src: noticiasBanner, width: 640, format: "webp" }),
]);
---

<a href={href} class="banner-cta">
  <picture>
    <source media="(max-width: 360px)" srcset={mobile.src} width={mobile.attributes.width} height={mobile.attributes.height} />
    <source media="(max-width: 849px)" srcset={tablet.src} width={tablet.attributes.width} height={tablet.attributes.height} />
    <img src={desktop.src} width={desktop.attributes.width} height={desktop.attributes.height} alt={imageAlt} loading="lazy" decoding="async" />
  </picture>
</a>

<style>
  .banner-cta {
    display: block;
  }

  .banner-cta img {
    width: 100%;
    height: auto;
  }
</style>
