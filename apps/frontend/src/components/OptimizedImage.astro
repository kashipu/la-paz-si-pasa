---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  sizes?: string;
  widths?: number[];
  slide?: number;
  hidden?: boolean;
};

const { src, alt, class: className, loading = "lazy", sizes, widths = [320, 640, 960], slide, hidden, ...attributes } = Astro.props;
const isRemote = typeof src === "string" && /^https?:\/\//.test(src);
---

{isRemote ? (
  <Image {...attributes} src={src as string} inferSize alt={alt} class={className} loading={loading} format="webp" widths={widths} sizes={sizes} data-slide={slide} aria-hidden={hidden} />
) : typeof src === "string" ? (
  <img {...attributes} src={src} alt={alt} class={className} loading={loading} decoding="async" data-slide={slide} aria-hidden={hidden} />
) : (
  <Image {...attributes} src={src as ImageMetadata} alt={alt} class={className} loading={loading} format="webp" widths={widths} sizes={sizes} data-slide={slide} aria-hidden={hidden} />
)}
