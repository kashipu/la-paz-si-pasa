---
export interface Props {
  id: string;
  name: string;
  color: string;
  isActive?: boolean;
}

const { id, name, color, isActive = false } = Astro.props;
---

<button 
  class={`tab-btn ${isActive ? 'active' : ''}`} 
  data-target={id}
  style={`--tab-color: ${color}`}
>
  <span class="tab-label">REGIÓN</span>
  <span class="tab-name">{name}</span>
</button>

<style>
  .tab-btn {
    background: transparent;
    border: 2px solid var(--tab-color);
    color: var(--tab-color);
    font-family: var(--font-monique-regular);
    padding: var(--space-3, 0.75rem) var(--space-2, 0.5rem);
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    background-color: var(--color-surface, #ffffff);
    border-radius: var(--radius-control, 6px);
    
    /* Responsive sizing */
    flex: 1 1 calc(33.333% - 1rem);
    min-width: 110px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .tab-btn {
      flex: 1 1 0; /* On larger screens, distribute equally */
      padding: var(--space-4, 1rem) var(--space-2, 0.5rem);
    }
  }

  .tab-btn:hover {
    background-color: var(--color-surface-muted, #f5f5f4);
  }

  .tab-btn.active {
    background-color: var(--tab-color);
    color: var(--color-surface, #ffffff);
  }

  .tab-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.9;
  }

  .tab-name {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 700;
    line-height: 1.1;
  }
</style>
