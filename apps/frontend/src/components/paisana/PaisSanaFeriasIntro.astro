---
import paisaje from "../../assets/paissana/paisaje.svg";
import ilustracionProductora from "../../assets/paissana/ilustracion-productora@3x.png";

// Sección 5 · Mockup: documentacion/seccion5@2x-100.jpg
// Introducción a "PaisSana en ferias": texto sobre la presencia de los
// productores en Agroexpo, ChocoShow, Cafés de Colombia, ANATO, Carnaval de
// Barranquilla e ICARRD, con ilustración circular de la productora al lado y
// banner de paisaje ilustrado a lo ancho en la parte inferior.
---

<section class="ferias-intro">
  <div class="ferias-intro-grid">
    <div class="ferias-intro-text">
      <h2>PAISSANA EN FERIAS:</h2>
      <h3>Nuestros productores en las grandes vitrinas del país</h3>
      <p>
        Del campo a los escenarios más grandes de Colombia y el mundo. Revive el
        recorrido comercial de nuestras organizaciones en eventos como <strong
          >Agroexpo, ChocoShow, Cafés de Colombia, ANATO, Carnaval de
          Barranquilla e ICCARD</strong
        >.
      </p>
      <p>
        Aquí se cruzan las miradas, las catas, los intercambios comerciales y el
        talento para demostrar que en la ruralidad está el futuro.
      </p>
    </div>

    <div class="ferias-intro-illustration">
      <div class="illustration-wrapper">
        <img
          src={ilustracionProductora.src}
          alt="Productora Ferias"
          width="400"
          height="400"
          class="circular-illustration"
        />
      </div>
    </div>
  </div>

  <div class="ferias-landscape-banner">
    <img
      src={paisaje.src}
      alt="Paisaje de Colombia"
      width="1200"
      height="200"
      class="landscape-img"
    />
  </div>
</section>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  .ferias-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
    width: 100%;
  }

  /* INTRO GRID (Text + Circular Illustration) */
  .ferias-intro-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8, 2rem);
    align-items: center;
  }

  /* TEXT AREA */
  .ferias-intro-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .ferias-intro-text h2 {
    margin: 0;
    font-family: var(--font-monique-regular);
    font-weight: 700;
  }

  .ferias-intro-text h3 {
    margin-bottom: var(--space-4, 1rem);
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-regular, 400);
  }

  .ferias-intro-text p {
    margin-bottom: var(--space-2, 0.5rem);
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
    line-height: 1.6;
  }

  .ferias-intro-text p strong {
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-heavy, 800);
  }

  /* ILLUSTRATION AREA */
  .ferias-intro-illustration {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .illustration-wrapper {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1 / 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .circular-illustration {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .circular-illustration:hover {
    transform: scale(1.05) rotate(2deg);
  }

  /* LANDSCAPE BANNER */
  .ferias-landscape-banner {
    width: 100%;
    overflow: hidden;
    margin-top: var(--space-4, 1rem);
  }

  .landscape-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* =========================================
     BREAKPOINT 850px
     ========================================= */
  @media (min-width: 850px) {
    .ferias-intro-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12, 3rem);
    }
  }

  /* =========================================
     BREAKPOINT 360px
     ========================================= */
  @media (max-width: 360px) {
    .landscape-img {
      height: 200px;
      object-fit: cover;
    }
  }
</style>
