---
import PaisSanaRegionTabBtn from "./PaisSanaRegionTabBtn.astro";
import mapAmazonia from "../../assets/mapas/amazonia@3x.png";
import mapAndina from "../../assets/mapas/andina@3x.png";
import mapCaribe from "../../assets/mapas/caribe@3x.png";
import mapOrinoquia from "../../assets/mapas/orinoquia@3x.png";
import mapPacifica from "../../assets/mapas/pacifica@3x.png";

// Mapeo dinámico de imágenes
const mapImages = {
  amazonia: mapAmazonia,
  andina: mapAndina,
  caribe: mapCaribe,
  orinoquia: mapOrinoquia,
  pacifica: mapPacifica
};

// Sección 3 · Mockup: documentacion/seccion3@2x-100.jpg
// Carrusel de mapas por región. Refactorizado para usar un arreglo de datos
// y no repetir código (DRY).

const regions = [
  {
    id: "caribe",
    name: "CARIBE",
    color: "#e88e2d",
    total: 61,
    deptos: [
      { name: "LA GUAJIRA", value: 3 },
      { name: "SUCRE", value: 17 },
      { name: "CESAR", value: 18 },
      { name: "BOLÍVAR", value: 13 },
      { name: "MAGDALENA", value: 1 },
      { name: "CÓRDOBA", value: 8 },
      { name: "ATLÁNTICO", value: 1 }
    ]
  },
  {
    id: "pacifica",
    name: "PACÍFICA",
    color: "var(--color-nav-text, #32509d)",
    total: 120,
    deptos: [
      { name: "CHOCÓ", value: 16 },
      { name: "VALLE DEL CAUCA", value: 34 },
      { name: "CAUCA", value: 63 },
      { name: "NARIÑO", value: 7 }
    ]
  },
  {
    id: "andina",
    name: "ANDINA",
    color: "#e65550",
    total: 152,
    deptos: [
      { name: "RISARALDA", value: 2 },
      { name: "TOLIMA", value: 35 },
      { name: "CALDAS", value: 1 },
      { name: "HUILA", value: 11 },
      { name: "QUINDÍO", value: 1 },
      { name: "BOYACÁ", value: 10 },
      { name: "ANTIOQUIA", value: 47 },
      { name: "BOGOTÁ", value: 20 },
      { name: "SANTANDER", value: 9 },
      { name: "CUNDINAMARCA", value: 1 },
      { name: "NORTE DE SANTANDER", value: 15 }
    ]
  },
  {
    id: "orinoquia",
    name: "ORINOQUÍA",
    color: "#845396",
    total: 93,
    deptos: [
      { name: "ARAUCA", value: 57 },
      { name: "CASANARE", value: 25 },
      { name: "VICHADA", value: 0 },
      { name: "META", value: 11 }
    ]
  },
  {
    id: "amazonia",
    name: "AMAZONÍA",
    color: "var(--color-loquehacemos-bg, #008861)",
    total: 42,
    deptos: [
      { name: "AMAZONAS", value: 1 },
      { name: "GUAVIARE", value: 4 },
      { name: "PUTUMAYO", value: 9 },
      { name: "CAQUETÁ", value: 28 }
    ]
  }
];
---

<section class="mapa-carrusel">
  <nav class="region-tabs" aria-label="Navegación de regiones">
    {regions.map((r) => (
      <PaisSanaRegionTabBtn 
        id={r.id} 
        name={r.name} 
        color={r.color} 
        isActive={r.id === 'pacifica'} 
      />
    ))}
  </nav>

  <div class="region-content-container">
    {regions.map((r) => (
      <div class={`region-content-grid tab-content ${r.id === 'pacifica' ? 'active' : ''}`} id={`tab-${r.id}`}>
        
        <!-- Columna izquierda: Stats -->
        <div class="region-stats">
          <div class="total-badge">
            <span class="count">{r.total > 0 ? r.total : '00'}</span>
            <span class="label">PRODUCTORES</span>
          </div>
          
          <ul class="deptos-list">
            {r.deptos.length > 0 ? (
              r.deptos.map(d => (
                <li><span>{d.name}:</span> <strong>{d.value < 10 ? '0'+d.value : d.value}</strong></li>
              ))
            ) : (
              <li style="color: var(--color-text-muted);">Información en desarrollo...</li>
            )}
          </ul>
        </div>

        <!-- Columna derecha: Mapa interactivo -->
        <div class="region-map-wrapper">
          <img 
            src={mapImages[r.id as keyof typeof mapImages].src}
            alt={`Mapa Región ${r.name}`} 
            class="map-image" 
          />
        </div>
        
      </div>
    ))}
  </div>
</section>

<style>
  .mapa-carrusel {
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
    width: 100%;
  }

  /* TABS NAVIGATION */
  .region-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4, 1rem);
    justify-content: center;
    align-items: center;
  }

  /* CONTENT GRID */
  .region-content-container {
    position: relative;
    width: 100%;
    margin-top: var(--space-8, 2rem);
  }

  .region-content-grid {
    display: none;
    grid-template-columns: 1fr;
    gap: var(--space-8, 2rem);
    align-items: center;
  }

  .region-content-grid.active {
    display: grid;
    animation: fadeIn 0.4s ease forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 768px) {
    .region-content-grid {
      /* Le damos mucho más espacio al mapa (ej. 33% a los stats y 67% al mapa) */
      grid-template-columns: 1fr 2fr;
      align-items: center;
    }
  }

  /* LEFT COL: STATS */
  .region-stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
    /* Removido el contenedor gris oscuro/claro */
    background-color: transparent;
    padding: 0;
    min-width: 320px;
  }

  .total-badge {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .total-badge .count {
    font-size: clamp(4rem, 8vw, 6rem); 
    font-weight: 500; /* Ajustado para parecerse más a la fuente del mockup */
    line-height: 1;
  }

  .total-badge .label {
    font-size: 1.5rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .deptos-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    /* Divide la lista en 2 columnas para regiones con muchos departamentos (ej. Andina, Caribe) */
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-4, 1rem);
    font-size: 1.25rem;
    /* Removida la línea superior */
    padding-top: var(--space-4, 1rem);
    color: var(--color-nav-text, #32509d);
    font-family: var(--font-monique-regular);
    font-weight: 700;
    text-transform: uppercase;
  }

  .deptos-list li {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 0.5em;
  }

  .deptos-list li strong {
    font-weight: 700;
  }

  /* RIGHT COL: MAP & PINS */
  .region-map-wrapper {
    position: relative;
    width: 100%;
    max-width: 700px;
    margin-inline: auto; /* Para centrarlo en la columna */
    border-radius: var(--radius-card, 8px);
    background-color: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .map-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    padding: 0;
  }

</style>

<script>
  // Manejo de tabs en el cliente para el carrusel de regiones
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.mapa-carrusel .tab-btn');
    const contents = document.querySelectorAll('.mapa-carrusel .tab-content');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        // Remover estado activo de todos
        tabs.forEach(t => t.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));
        
        // Activar seleccionado
        tab.classList.add('active');
        const targetId = tab.getAttribute('data-target');
        
        // Mostrar contenedor correspondiente
        const targetContent = document.getElementById(`tab-${targetId}`);
        if (targetContent) {
          targetContent.classList.add('active');
        }
      });
    });
  });
</script>
