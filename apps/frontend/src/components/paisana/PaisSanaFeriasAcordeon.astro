---
import type { Feria } from "@adapters/contracts";
import PaisSanaFeriaItem from './PaisSanaFeriaItem.astro';

// Sección 6 · Mockup: documentacion/seccion6@2x-100.jpg
// Las ferias vienen del CPT `feria` vía props de la página. Una sola abierta a la vez:
// la primera marcada como "abierta por defecto" en WordPress, si hay alguna.
type Props = { ferias: Feria[] };
const { ferias } = Astro.props;

const indiceAbierta = ferias.findIndex((feria) => feria.abiertaPorDefecto);
---

<section class="ferias-acordeon-list">
  {ferias.map((feria, i) => (
    <PaisSanaFeriaItem feria={feria} isOpen={i === indiceAbierta} />
  ))}
</section>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  .ferias-acordeon-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    width: 100%;
  }

  /* =========================================
     BREAKPOINT 850px
     ========================================= */

  /* =========================================
     BREAKPOINT 360px
     ========================================= */
</style>

<script>
  // Exclusividad de acordeón: sólo una pestaña abierta a la vez
  document.addEventListener('astro:page-load', () => {
    const feriaItems = document.querySelectorAll<HTMLDetailsElement>('.ferias-acordeon-list .feria-item');
    
    feriaItems.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (item.open) {
          feriaItems.forEach((other) => {
            if (other !== item && other.open) {
              other.open = false;
            }
          });
        }
      });
    });
  });
</script>
