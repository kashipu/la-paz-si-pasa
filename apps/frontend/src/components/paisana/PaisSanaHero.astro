---
import logoPaisana from "../../assets/paissana/logo-paisana.svg";
import { Image } from "astro:assets";
import flor from "../../assets/paissana/flor.svg";
import icon from "../../assets/paissana/icon.svg";
import leaf from "../../assets/paissana/leaf.svg";
import heroImage from "../../assets/paissana/paisana-hero-image@3x.png";

// Sección 1 · Mockup: documentacion/Seccion1@2x-100.jpg
// Encabezado de marca PaisSana: logo + texto de introducción, bloque de "Datos
// relevantes" con ilustración de flor arriba a la derecha, y abajo la lista
// de beneficios para productores junto a la foto cuadrada de la productora.
---

<section class="paisana-hero">
  <div class="hero-top-grid">
    <div class="hero-brand">
      <img
        src={logoPaisana.src}
        alt="PaisSana"
        width="350"
        height="116"
        class="brand-logo"
      />
      <h2>Un país que sana desde la tierra</h2>
      <p>
        PaisSana no es solo una marca; es la voz, las manos y el orgullo de
        miles de familias productoras que decidieron transformar la historia de
        sus territorios.
      </p>
      <p>
        Detrás de cada grano de café, de cada barra de cacao, de la miel o de
        las artesanías que nacen en las regiones PDET, hay un relato de
        <strong> resiliencia, trabajo honesto y esperanza renovada. </strong>
        Aquí, el comercio se convierte en una herramienta para construir equidad y
        los frutos de la tierra en el reflejo de un país que florece en paz.
      </p>
    </div>

    <div class="hero-stats">
      <div class="flor-content">
        <img
          src={flor.src}
          alt="Flor"
          class="flor-img"
          width="300"
          height="300"
        />
      </div>
      <h3>Datos relevantes:</h3>
      <ul class="stats-list">
        <li>
          <span class="stat-number">450</span>
          <span class="stat-text"
            >Organizaciones y productores vigentes con acuerdos comerciales en
            pie.</span
          >
        </li>
        <li>
          <div class="stat-icon-wrapper">
            <img src={icon.src} width="48" height="48" alt="Sello" />
          </div>
          <div class="stat-content">
            <span class="stat-number">3.402</span>
            <span class="stat-text"
              >Productos con sello de origen que garantizan calidad y
              procedencia.</span
            >
          </div>
        </li>
        <li>
          <div class="stat-icon-wrapper">
            <img src={leaf.src} width="48" height="48" alt="Municipios" />
          </div>
          <div class="stat-content">
            <span class="stat-number">168</span>
            <span class="stat-text"
              >Municipios sembrando el cambio en las regiones más afectadas por
              el conflicto.</span
            >
          </div>
        </li>
      </ul>
    </div>
  </div>

  <div class="hero-bottom-grid">
    <div class="hero-benefits">
      <h3>Beneficios para los productores:</h3>
      <ul class="benefits-list">
        <li>Registro ante la Superintendencia de Industria y Comercio.</li>
        <li>
          Acompañamiento ante el INVIMA: asistencia técnica especializada para
          trámites y requisitos.
        </li>
        <li>
          Acompañamiento ante el ICA: capacitaciones en normatividad y apoyo en
          la certificación.
        </li>
        <li>
          Alianzas estratégicas con Fondo Emprender y CampeSENA para acceso a
          capital semilla.
        </li>
        <li>
          Conexión con comercializadoras y plataformas de mercado nacional e
          internacional.
        </li>
      </ul>
    </div>
    <div class="hero-photo">
      <Image
        src={heroImage}
        alt="Productora PaisSana"
        width={600}
        height={600}
        format="webp"
        sizes="(min-width: 850px) 50vw, 100vw"
      />
    </div>
  </div>
  <nav class="hero-nav" aria-label="Navegación de secciones PaisSana">
    <ul class="hero-nav__list">
      <li>
        <a href="#escucha-el-corazon-del-campo">ESCUCHA EL CORAZÓN DEL CAMPO</a>
      </li>
      <li>
        <a href="#paissana-en-ferias">PAISSANA EN FERIAS</a>
      </li>
      <li>
        <a href="#productores-paissana">PRODUCTORES PAISSANA</a>
      </li>
    </ul>
  </nav>
</section>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  .paisana-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-12, 3rem);
    width: 100%;
    color: var(--color-text);
  }

  .hero-top-grid,
  .hero-bottom-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8, 2rem);
  }

  /* BRAND SECTION */
  .hero-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
  }

  .brand-logo {
    width: 100%;
    max-width: 350px;
    height: auto;
    object-fit: contain;
  }

  .hero-brand h2 {
    margin-top: var(--space-4, 1rem);
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-heavy, 800);
  }

  /* STATS SECTION */
  .hero-stats {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
  }

  .flor-content {
    position: relative;
    padding: 0;
  }

  .flor-img {
    position: absolute;
    top: 0;
    right: 0;
    max-width: 180px;
    height: auto;
    object-fit: contain;
    pointer-events: none;
    z-index: 0;
  }

  .hero-stats h3 {
    position: relative;
    z-index: 1;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-heavy, 800);
  }

  .stats-list {
    list-style: none;
    padding: 1rem 5rem 3rem 1rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6, 1.5rem);
    z-index: 1;
    position: relative;
  }

  .stats-list li {
    list-style: none;
    list-style-type: none;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4, 1rem);
  }

  .stat-icon-wrapper {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-icon-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .stat-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1, 0.25rem);
  }

  .stats-list li:first-child {
    flex-direction: column;
    gap: var(--space-1, 0.25rem);
  }

  .stat-number {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-heavy, 800);
    color: var(--color-nav-text, #32509d);
    line-height: 1;
  }

  .stat-text {
    padding: 0 1rem 0 0;
  }

  /* BENEFITS SECTION */
  .hero-benefits {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    padding-right: 0;
  }

  .hero-benefits h3 {
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-heavy, 800);
  }



  .benefits-list {
    list-style: disc;
    padding: 0 0 0 1.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
  }

  .benefits-list li {
    position: relative;
  }

  /* PHOTO SECTION */
  .hero-photo {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
  }

  .hero-photo img {
    width: 100%;
    max-width: 80%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 1 / 1;
    box-sizing: border-box;
    border: 10px solid var(--color-surface);
    box-shadow: 0 2.2rem 3rem rgba(0, 0, 0, 0.55), 0 0.4rem 1rem rgba(0, 0, 0, 0.3);
    transform: rotate(-4deg);
    transition: transform 0.5s ease;
  }

  .hero-photo:hover img {
    transform: rotate(-2deg) scale(1.02);
  }

  /* HERO NAV BUTTONS */
  .hero-nav {
    width: 100%;
  }

  .hero-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .hero-nav__list a {
    display: block;
    text-align: center;
    padding-block: var(--space-3);
    border: 1px solid var(--color-nav-border);
    color: var(--color-nav-text);
    font-family: var(--font-monique-regular);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    background: var(--color-surface);
    transition: background-color 0.15s ease;
    line-height: 1.5;
  }

  .hero-nav__list a:hover,
  .hero-nav__list a:focus-visible {
    background: var(--color-nav-bg-active);
  }

  /* =========================================
     BREAKPOINT 850px
     ========================================= */
  @media (min-width: 850px) {
    .hero-nav__list {
      grid-template-columns: repeat(3, 1fr);
    }
    .hero-top-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 0;
    }
    .hero-bottom-grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
    .hero-brand {
      padding: 0 var(--space-8, 2rem) 0 0;
    }
    .hero-stats {
      border-left: 1px solid var(--color-nav-text, #32509d);
      padding: 0 0 0 var(--space-8, 2rem);
    }
    .flor-img {
      max-width: 250px;
    }
    .stat-text {
      padding: 0 3rem 0 0;
    }
    .hero-benefits {
      padding-right: var(--space-4, 1rem);
    }
  }

  /* =========================================
     BREAKPOINT 360px
     ========================================= */
  @media (max-width: 360px) {
    .stats-list {
      padding-right: 16px;
    }
    .flor-content {
      padding: 1rem;
    }
    .flor-img {
      max-width: 100px;
    }
  }
</style>
