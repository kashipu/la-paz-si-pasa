---
import tucan from "../../assets/paissana/tucan.svg";
import { mockVideos } from "../../adapters/mocks";

// Seleccionamos los videos mock del proyecto con el sello PaiSana
const paisanaVideos = mockVideos.filter((v) => v.tags.includes("PaiSana"));
---

<link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />

<section class="productores-videos">
  <div class="productores-header-grid">
    <div class="productores-header-text">
      <h2>PRODUCTORES PAISSANA:</h2>
      <h3>Historias que transforman: el rostro de la paz</h3>
      <p>Detrás de cada producto con el sello PaisSana hay hombres y mujeres valientes que creyeron en el poder de la legalidad, el trabajo asociativo y el desarrollo sostenible. <strong>A través de estas crónicas audiovisuales y contenidos, conoce a los verdaderos protagonistas de PaisSana:</strong> historias inspiradoras que demuestran cómo la producción local construye una Colombia que sana y avanza.</p>
    </div>
    <div class="productores-header-tucan">
      <img src={tucan.src} alt="Tucán" width="200" height="300" class="tucan-img" />
    </div>
  </div>

  <div class="videos-list">
    {paisanaVideos.map((video, index) => (
      <article class="video-row-card">
        <div class="video-thumb">
          <div class="plyr__video-embed js-plyr">
            <iframe
              src={`${video.videoUrl}?origin=https://plyr.io&amp;iv_load_policy=3&amp;modestbranding=1&amp;playsinline=1&amp;showinfo=0&amp;rel=0&amp;enablejsapi=1`}
              allowfullscreen
              allowtransparency
              allow="autoplay"
              title={video.titulo}
            ></iframe>
          </div>
        </div>
        <div class="video-info">
          <h3>{video.titulo}</h3>
          <p class="video-subtitle">Crónica #{index + 1}</p>
          <p class="video-desc">{video.descripcion}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  .productores-videos {
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
    width: 100%;
  }

  /* HEADER TEXT & TUCAN */
  .productores-header-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 1.5rem);
    align-items: center;
  }

  .productores-header-text h2 {
    margin: 0;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-heavy, 800);
    color: var(--color-nav-text, #32509d);
  }

  .productores-header-text h3 {
    margin-top: var(--space-2, 0.5rem);
    margin-bottom: var(--space-4, 1rem);
    font-family: var(--font-komet);
    font-size: 1.5rem;
    font-weight: var(--font-weight-komet-regular, 400);
    color: var(--color-nav-text, #32509d);
  }

  .productores-header-text p {
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
    line-height: 1.6;
    color: var(--color-nav-text, #32509d);
  }

  .productores-header-text strong {
    font-weight: var(--font-weight-komet-heavy, 800);
  }

  .productores-header-tucan {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .tucan-img {
    max-width: 200px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.1));
    transition: transform 0.4s ease;
  }

  .tucan-img:hover {
    transform: rotate(-3deg) scale(1.05);
  }

  /* VIDEOS LIST */
  .videos-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: var(--space-4, 1rem);
  }

  /* VIDEO ROW CARD */
  .video-row-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 1.5rem);
    background-color: transparent;
    border-top: 1px solid var(--color-nav-text, #32509d);
    border-bottom: none;
    border-left: none;
    border-right: none;
    padding-block: var(--space-6, 1.5rem);
    padding-inline: 0;
  }

  .video-row-card:last-child {
    border-bottom: 1px solid var(--color-nav-text, #32509d);
  }

  /* THUMBNAIL / PLYR CONTAINER */
  .video-thumb {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    width: 100%;
    order: 1;
  }

  /* PLYR STYLES OVERRIDE */
  :global(.plyr) {
    --plyr-color-main: #32509d;
    border-radius: 6px;
    overflow: hidden;
    width: 100%;
    height: 100%;
  }

  /* VIDEO INFO */
  .video-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
    justify-content: center;
    color: var(--color-nav-text, #32509d);
    font-family: var(--font-komet);
    order: 2;
  }

  .video-info h3 {
    margin: 0;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-heavy, 800);
    font-size: 1.5rem;
    color: var(--color-nav-text, #32509d);
    line-height: 1.25;
  }

  .video-subtitle {
    margin: 0;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
    font-size: 0.95rem;
    color: var(--color-nav-text, #32509d);
    opacity: 0.9;
  }

  .video-desc {
    margin: 0;
    margin-top: var(--space-2, 0.5rem);
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-nav-text, #32509d);
  }

  /* =========================================
     BREAKPOINT 850px
     ========================================= */
  @media (min-width: 850px) {
    .productores-header-grid {
      grid-template-columns: 3fr 1fr;
    }

    .video-row-card {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      padding-block: var(--space-8, 2rem);
    }

    .video-thumb {
      order: 1;
    }

    .video-info {
      order: 2;
    }
  }

  /* =========================================
     BREAKPOINT 360px
     ========================================= */
</style>

<script is:inline src="https://cdn.plyr.io/3.7.8/plyr.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initPlyr = () => {
      const players = document.querySelectorAll('.js-plyr');
      players.forEach((player) => {
        if (typeof (window as any).Plyr !== 'undefined') {
          new (window as any).Plyr(player, {
            controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'fullscreen']
          });
        }
      });
    };

    if (typeof (window as any).Plyr !== 'undefined') {
      initPlyr();
    } else {
      setTimeout(initPlyr, 500);
    }
  });
</script>
