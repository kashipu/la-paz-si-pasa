---
import tucan from "../../assets/paissana/tucan.svg";
import type { Video } from "@adapters/contracts";
import OptimizedImage from "../OptimizedImage.astro";

// La página filtra por el sello PaisSana y entrega los videos ya listos.
type Props = { videos: Video[] };
const { videos: paisanaVideos } = Astro.props;

function playerUrl(video: Video, origin: string) {
  if (video.fuente !== "youtube") return video.videoUrl;

  const url = new URL(video.videoUrl);
  url.searchParams.set("playsinline", "1");
  url.searchParams.set("rel", "0");
  url.searchParams.set("enablejsapi", "1");
  url.searchParams.set("origin", origin);
  return url.toString();
}
---

<section class="productores-videos" id="productores-paissana">
  <div class="productores-header-grid">
    <div class="productores-header-text">
      <h2>PRODUCTORES PAISSANA:</h2>
      <h3>Historias que transforman: el rostro de la paz</h3>
      <p>Detrás de cada producto con el sello PaisSana hay hombres y mujeres valientes que creyeron en el poder de la legalidad, el trabajo asociativo y el desarrollo sostenible. <strong>A través de estas crónicas audiovisuales y contenidos, conoce a los verdaderos protagonistas de PaisSana:</strong> historias inspiradoras que demuestran cómo la producción local construye una Colombia que sana y avanza.</p>
    </div>
    <div class="productores-header-tucan">
      <img src={tucan.src} alt="Tucán" width="200" height="300" class="tucan-img" />
    </div>
  </div>

  <div class="videos-list">
    {paisanaVideos.map((video, index) => (
      <article class="video-row-card">
        <div class="video-thumb">
          {video.estado === "no-disponible" ? (
            <p class="video-unavailable" role="status">Video no disponible.</p>
          ) : (
            <button
              type="button"
              class="video-placeholder js-video-placeholder"
              data-source={video.fuente}
              data-src={playerUrl(video, Astro.url.origin)}
              data-title={video.titulo}
              aria-label={`Cargar video: ${video.titulo}`}
            >
              {video.thumbnailUrl && <OptimizedImage src={video.thumbnailUrl} alt="" sizes="(min-width: 850px) 55vw, 100vw" />}
              <span aria-hidden="true">▶</span>
            </button>
          )}
        </div>
        <div class="video-info">
          <h3>{video.titulo}</h3>
          <p class="video-subtitle">Crónica #{index + 1}</p>
          <p class="video-desc">{video.descripcion}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  .productores-videos {
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
    width: 100%;
  }

  /* HEADER TEXT & TUCAN */
  .productores-header-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 1.5rem);
    align-items: center;
  }

  .productores-header-text h2 {
    margin: 0;
    font-family: var(--font-monique-regular);
    font-weight: 800;
    color: var(--color-nav-text, #32509d);
  }

  .productores-header-text h3 {
    margin-top: var(--space-2, 0.5rem);
    margin-bottom: var(--space-4, 1rem);
    font-family: var(--font-komet);
    font-size: 1.5rem;
    font-weight: var(--font-weight-komet-regular, 400);
    color: var(--color-nav-text, #32509d);
  }

  .productores-header-text p {
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
    line-height: 1.6;
    color: var(--color-nav-text, #32509d);
  }

  .productores-header-text strong {
    font-weight: var(--font-weight-komet-heavy, 800);
  }

  .productores-header-tucan {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .tucan-img {
    max-width: 200px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.1));
    transition: transform 0.4s ease;
  }

  .tucan-img:hover {
    transform: rotate(-3deg) scale(1.05);
  }

  /* VIDEOS LIST */
  .videos-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: var(--space-4, 1rem);
  }

  /* VIDEO ROW CARD */
  .video-row-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 1.5rem);
    background-color: transparent;
    border-top: 1px solid var(--color-nav-text, #32509d);
    border-bottom: none;
    border-left: none;
    border-right: none;
    padding-block: var(--space-6, 1.5rem);
    padding-inline: 0;
  }

  .video-row-card:last-child {
    border-bottom: 1px solid var(--color-nav-text, #32509d);
  }

  /* THUMBNAIL / PLYR CONTAINER */
  .video-thumb {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    width: 100%;
    order: 1;
  }

  .video-placeholder,
  .video-unavailable {
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    background: var(--color-surface-muted, #f5f5f4);
  }

  .video-placeholder {
    position: relative;
    display: grid;
    place-items: center;
    cursor: pointer;
    overflow: hidden;
  }

  .video-placeholder img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-placeholder span {
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 90%);
    color: var(--color-nav-text, #32509d);
  }

  .video-unavailable {
    display: grid;
    place-items: center;
    color: var(--color-nav-text, #32509d);
  }

  /* PLYR STYLES OVERRIDE */
  :global(.plyr) {
    --plyr-color-main: #32509d;
    border-radius: 6px;
    overflow: hidden;
    width: 100%;
    height: 100%;
  }

  /* VIDEO INFO */
  .video-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
    justify-content: center;
    color: var(--color-nav-text, #32509d);
    font-family: var(--font-komet);
    order: 2;
  }

  .video-info h3 {
    margin: 0;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-heavy, 800);
    font-size: 1.5rem;
    color: var(--color-nav-text, #32509d);
    line-height: 1.25;
  }

  .video-subtitle {
    margin: 0;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
    font-size: 0.95rem;
    color: var(--color-nav-text, #32509d);
    opacity: 0.9;
  }

  .video-desc {
    margin: 0;
    margin-top: var(--space-2, 0.5rem);
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-nav-text, #32509d);
  }

  /* =========================================
     BREAKPOINT 850px
     ========================================= */
  @media (min-width: 850px) {
    .productores-header-grid {
      grid-template-columns: 3fr 1fr;
    }

    .video-row-card {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      padding-block: var(--space-8, 2rem);
    }

    .video-thumb {
      order: 1;
    }

    .video-info {
      order: 2;
    }
  }

  /* =========================================
     BREAKPOINT 360px
     ========================================= */
</style>

<script>
  const PLYR_SRC = "https://cdn.plyr.io/3.7.8/plyr.js";
  const PLYR_CSS = "https://cdn.plyr.io/3.7.8/plyr.css";
  let plyrPromise: Promise<void> | undefined;
  let plyrStylesPromise: Promise<void> | undefined;

  function loadPlyr() {
    if ((window as any).Plyr) return Promise.resolve();
    if (plyrPromise) return plyrPromise;

    plyrPromise = new Promise<void>((resolve, reject) => {
      const script = document.createElement("script");
      script.src = PLYR_SRC;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error("No se pudo cargar Plyr"));
      document.head.appendChild(script);
    });
    return plyrPromise;
  }

  function loadPlyrStyles() {
    if (document.querySelector(`link[href="${PLYR_CSS}"]`)) return Promise.resolve();
    if (plyrStylesPromise) return plyrStylesPromise;

    plyrStylesPromise = new Promise<void>((resolve, reject) => {
      const stylesheet = document.createElement("link");
      stylesheet.rel = "stylesheet";
      stylesheet.href = PLYR_CSS;
      stylesheet.onload = () => resolve();
      stylesheet.onerror = () => reject(new Error("No se pudo cargar el CSS de Plyr"));
      document.head.appendChild(stylesheet);
    });
    return plyrStylesPromise;
  }

  document.addEventListener('astro:page-load', () => {
    const section = document.querySelector('.productores-videos');
    if (!section) return;

    const mountPlayer = async (placeholder: HTMLButtonElement) => {
      try {
        await Promise.all([loadPlyr(), loadPlyrStyles()]);
        const source = placeholder.dataset.source;
        const src = placeholder.dataset.src;
        const title = placeholder.dataset.title ?? "Video";
        if (!src) return;

        const player = source === "youtube" ? document.createElement("div") : document.createElement("video");
        if (source === "youtube") {
          player.className = "plyr__video-embed";
          const iframe = document.createElement("iframe");
          iframe.src = src;
          iframe.title = title;
          iframe.allow = "autoplay; encrypted-media; picture-in-picture";
          iframe.allowFullscreen = true;
          player.appendChild(iframe);
        } else {
          const video = player as HTMLVideoElement;
          video.src = src;
          video.controls = true;
        }

        placeholder.replaceWith(player);
        new (window as any).Plyr(player, {
          controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'fullscreen']
        });
      } catch (error) {
        console.warn(error);
      }
    };

    const observer = new IntersectionObserver((entries) => {
      entries.filter((entry) => entry.isIntersecting).forEach((entry) => {
        observer.unobserve(entry.target);
        void mountPlayer(entry.target as HTMLButtonElement);
      });
    }, { rootMargin: '300px' });

    section.querySelectorAll<HTMLButtonElement>('.js-video-placeholder').forEach((placeholder) => observer.observe(placeholder));
  });
</script>
