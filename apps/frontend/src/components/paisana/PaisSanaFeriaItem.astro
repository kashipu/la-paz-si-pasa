---
import type { Feria } from "@adapters/contracts";

type Props = { feria: Feria; isOpen?: boolean };
const { feria, isOpen = false } = Astro.props;
const { titulo, descripcion, galeria, videos } = feria;
---

<details class="feria-item" open={isOpen} name="ferias-acordeon">
  <summary class="feria-header">
    <span class="feria-title">{titulo}</span>
    <span class="chevron">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </span>
  </summary>
  <div class:list={["feria-body-grid", videos.length === 0 && "sin-video"]}>
    <div class="feria-left">
      <p class="feria-desc">{descripcion}</p>
      {galeria.length > 0 && (
        <>
          <h3 class="gallery-title">GALERÍA FOTOGRÁFICA</h3>
          <div class="gallery-grid-3x2">
            {galeria.map((foto) => (
              <button type="button" class="gallery-item" aria-label={`Ampliar ${foto.alt}`}>
                <img src={foto.url} alt={foto.alt} width="300" height="200" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </>
      )}
    </div>
    {videos.length > 0 && (
      <div class="feria-right">
        <div class="vertical-video-card" data-carrusel>
          {videos.map((video, i) => (
            <div class="video-slide" hidden={i !== 0}>
              <div class="video-media" data-video-source={video.fuente} data-video-src={video.url}>
                {video.thumbnailUrl
                  ? <img src={video.thumbnailUrl} alt={video.alt} width="400" height="600" loading="lazy" decoding="async" />
                  : <div class="video-media__sin-miniatura" aria-hidden="true"></div>}
                <button class="play-btn-overlay" aria-label={`Reproducir ${video.alt}`}>
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="white" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                </button>
              </div>
              {video.pie && <p class="video-pie">{video.pie}</p>}
            </div>
          ))}
          {videos.length > 1 && (
            <div class="video-nav">
              <p class="video-contador" aria-live="polite">1 / {videos.length}</p>
              <div class="video-nav-btns">
                <button class="video-nav-btn" data-paso="-1" aria-label={`Video anterior de ${titulo}`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <button class="video-nav-btn" data-paso="1" aria-label={`Video siguiente de ${titulo}`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
              </div>
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</details>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  /* DETAILS / SUMMARY STRUCTURE */
  .feria-item {
    background-color: #cbe9f8;
    border: 1px solid transparent;
    border-radius: var(--radius-card, 8px);
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  .feria-item[open] {
    background-color: #ffffff;
    border: 1px solid #32509d;
    box-shadow: var(--shadow-soft);
  }

  .feria-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4, 1rem) var(--space-6, 1.5rem);
    cursor: pointer;
    list-style: none; /* Hide default triangle */
    background-color: #cbe9f8; /* Azul #CBE9F8 al estar cerrado */
    transition: background-color 0.2s ease;
  }
  
  /* Hide native summary marker for webkit */
  .feria-header::-webkit-details-marker {
    display: none;
  }

  .feria-header:hover {
    background-color: #b5ddf5; /* Azul sutil al hacer hover */
  }

  .feria-item[open] .feria-header {
    background-color: #ffffff; /* Blanco al estar desplegado/abierto */
    border-bottom: 1px solid #32509d;
  }

  .feria-item[open] .feria-header:hover {
    background-color: #f5f5f4;
  }

  .feria-title {
    font-size: 1.25rem;
    font-family: var(--font-monique-regular);
    font-weight: 700;
    color: var(--color-nav-text, #32509d);
    text-transform: uppercase;
  }

  .chevron {
    color: var(--color-nav-text, #32509d);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .feria-item[open] .chevron {
    transform: rotate(180deg);
  }

  /* ACORDION CONTENT GRID */
  .feria-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8, 2rem);
    padding: var(--space-6, 1.5rem);
    animation: slideDown 0.4s ease;
    background-color: #ffffff;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* LEFT SIDE (Desc + Gallery) */
  .feria-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-6, 1.5rem);
  }

  .feria-desc {
    font-size: 1.125rem;
    line-height: 1.6;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
    letter-spacing: -0.42px;
    color: var(--color-nav-text, #32509d);
  }

  .gallery-title {
    font-size: 1.25rem;
    font-family: var(--font-monique-regular);
    font-weight: 700;
    color: var(--color-nav-text, #32509d);
    padding-left: 0;
  }

  .gallery-grid-3x2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3, 0.75rem);
  }

  .gallery-item {
    display: block;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .gallery-item:focus-visible {
    outline: 2px solid var(--color-loquehacemos-bg, #008861);
    outline-offset: 2px;
  }

  .gallery-grid-3x2 img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 2;
    border-radius: 4px;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.03);
    filter: brightness(1.1);
    box-shadow: 0 5px 15px rgba(0,0,0,0.15);
    z-index: 2;
  }

  /* RIGHT SIDE (Video Card) */
  .feria-right {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .vertical-video-card {
    background-color: var(--color-surface, #ffffff);
    padding: var(--space-4, 1rem);
    border-radius: var(--radius-card, 8px);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    width: 80%;
  }

  .video-slide {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
  }

  .video-slide[hidden] {
    display: none;
  }

  .video-pie {
    font-size: 0.9375rem;
    line-height: 1.4;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
    color: var(--color-nav-text, #32509d);
  }

  .video-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4, 1rem);
    border-top: 1px solid var(--color-nav-text, #32509d);
    padding-top: var(--space-3, 0.75rem);
  }

  .video-contador {
    font-family: var(--font-komet);
    font-size: 0.875rem;
    color: var(--color-nav-text, #32509d);
  }

  .video-nav-btns {
    display: flex;
    gap: var(--space-2, 0.5rem);
  }

  .video-nav-btn {
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background-color: var(--color-nav-text, #32509d);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .video-nav-btn:hover {
    background-color: var(--color-loquehacemos-bg, #008861);
    transform: scale(1.1);
  }

  .video-nav-btn:focus-visible {
    outline: 2px solid var(--color-loquehacemos-bg, #008861);
    outline-offset: 2px;
  }

  /* Video sin miniatura: ocupa la proporción del contenedor. */
  .video-media__sin-miniatura {
    width: 100%;
    height: 100%;
    background: var(--color-nav-bg-active, #e6e6e6);
  }

  :global(.video-media iframe),
  :global(.video-media video) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-media {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 9 / 16;
  }

  .video-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-btn-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 72px;
    height: 72px;
    background-color: rgba(15, 118, 110, 0.85); /* brand accent */
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    transition: all 0.2s ease;
  }

  .play-btn-overlay:hover {
    background-color: var(--color-loquehacemos-bg, #008861);
    transform: translate(-50%, -50%) scale(1.1);
  }

  /* =========================================
     BREAKPOINT 850px
     ========================================= */
  @media (min-width: 850px) {
    /* Texto + galería a la izquierda, carrusel de video a la derecha. Sin video
       la galería se queda con todo el ancho. */
    .feria-body-grid {
      grid-template-columns: 2fr 1fr;
    }

    .feria-body-grid.sin-video {
      grid-template-columns: 1fr;
    }

    .gallery-grid-3x2 {
      grid-template-columns: repeat(3, 1fr);
    }

    .vertical-video-card {
      width: 100%;
    }
  }

  /* =========================================
     BREAKPOINT 360px
     ========================================= */
</style>

<!-- El lightbox lo crea el script fuera del scope de Astro: estilos globales. -->
<style is:global>
  .lightbox {
    max-width: 92vw;
    max-height: 92vh;
    padding: 0;
    border: none;
    background: none;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }

  .lightbox img {
    display: block;
    max-width: 92vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    border-radius: 6px;
  }

  .lightbox-cerrar {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background-color: var(--color-nav-text, #32509d);
    color: #ffffff;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

<script>
  // Reemplaza la miniatura por el reproductor real al pulsar play.
  // Delegado en document: cubre todas las ferias con un solo listener.
  // Lightbox de galería: un único <dialog> nativo reutilizado por todas las ferias.
  // Esc y backdrop los gestiona el navegador; sólo cerramos al pulsar fuera de la imagen.
  function abrirLightbox(foto: HTMLImageElement) {
    let dialogo = document.querySelector<HTMLDialogElement>(".lightbox");
    if (!dialogo) {
      dialogo = document.createElement("dialog");
      dialogo.className = "lightbox";
      dialogo.innerHTML =
        '<img alt=""><button type="button" class="lightbox-cerrar" aria-label="Cerrar">✕</button>';
      dialogo.addEventListener("click", (event) => {
        if (event.target === dialogo || (event.target as HTMLElement).closest(".lightbox-cerrar")) {
          dialogo!.close();
        }
      });
      document.body.append(dialogo);
    }

    const ampliada = dialogo.querySelector("img")!;
    ampliada.src = foto.currentSrc || foto.src;
    ampliada.alt = foto.alt;
    dialogo.showModal();
  }

  import { detenerVideos, guardarMiniatura } from "./feriaVideos.ts";

  document.addEventListener("astro:page-load", () => {
    // toggle no burbujea: se captura. Al cerrarse una feria (a mano o por la
    // exclusividad del acordeón) se detiene cualquier video que sonara dentro.
    document.addEventListener(
      "toggle",
      (event) => {
        const item = event.target;
        if (item instanceof HTMLDetailsElement && !item.open) detenerVideos(item);
      },
      true,
    );

    document.addEventListener("click", (event) => {
      const paso = (event.target as HTMLElement)?.closest?.<HTMLElement>(".video-nav-btn");
      if (paso) {
        const carrusel = paso.closest<HTMLElement>("[data-carrusel]");
        const slides = [...(carrusel?.querySelectorAll<HTMLElement>(".video-slide") ?? [])];
        if (!slides.length) return;

        const actual = slides.findIndex((slide) => !slide.hidden);
        // El módulo da la vuelta en los dos sentidos: +slides.length porque en
        // JS el resto de un negativo es negativo.
        const siguiente = (actual + Number(paso.dataset.paso) + slides.length) % slides.length;
        slides.forEach((slide, i) => (slide.hidden = i !== siguiente));
        detenerVideos(slides[actual]!);

        const contador = carrusel?.querySelector(".video-contador");
        if (contador) contador.textContent = `${siguiente + 1} / ${slides.length}`;
        return;
      }

      const foto = (event.target as HTMLElement)?.closest?.<HTMLElement>(".gallery-item")
        ?.querySelector("img");
      if (foto) {
        abrirLightbox(foto);
        return;
      }

      const boton = (event.target as HTMLElement)?.closest?.(".play-btn-overlay");
      if (!boton) return;

      const media = boton.closest<HTMLElement>(".video-media");
      const src = media?.dataset.videoSrc;
      if (!media || !src) return;

      guardarMiniatura(media);

      if (media.dataset.videoSource === "youtube") {
        const iframe = document.createElement("iframe");
        iframe.src = `${src}${src.includes("?") ? "&" : "?"}autoplay=1&rel=0&playsinline=1`;
        iframe.title = boton.getAttribute("aria-label") ?? "Video";
        iframe.allow = "accelerometer; autoplay; encrypted-media; picture-in-picture";
        iframe.allowFullscreen = true;
        media.replaceChildren(iframe);
      } else {
        const video = document.createElement("video");
        video.src = src;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        media.replaceChildren(video);
      }
    });
  });
</script>
