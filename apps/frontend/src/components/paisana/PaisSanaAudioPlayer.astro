---
// Sección 4 · Mockup: documentacion/seccion4@2x-100.jpg
// "El corazón del campo": reproductor de relatos sonoros. Card con botón de
// reproducción, datos del productor (nombre, marca, municipio), barra de progreso
// con timestamps, caja de subtítulos y flechas para pasar de un audio a otro.
---

<section class="corazon-campo">
  <div class="audio-header">
    <div class="header-left">
      <h2>
        EL CORAZÓN<br />DEL CAMPO:<br />
        <span class="highlight">La voz del territorio</span>
      </h2>
    </div>
    <div class="header-right">
      <p>
        Nadie narra la transformación mejor que quienes la viven día a día en el
        surco, la parcela o el taller. <strong>Te invitamos a cerrar los ojos y escuchar estos relatos sonoros
        grabados directamente en el territorio.</strong>
      </p>
      <p>
        En sus propias voces, las y los productores nos comparten sus memorias,
        sus sueños y la emoción de ver cómo el trabajo de la tierra está
        transformando el futuro de sus familias.
      </p>
    </div>
  </div>

  <div class="audio-player-wrapper">
    <div class="audio-player-card">
      <div class="player-left">
        <div class="producer-info-container">
          <button
            class="play-pause-btn"
            aria-label="Reproducir audio"
            id="playPauseBtn"
          >
            <!-- Icono de Play -->
            <svg
              class="icon-play"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="currentColor"
              stroke="none"
            >
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <!-- Icono de Pause -->
            <svg
              class="icon-pause"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="currentColor"
              stroke="none"
              style="display: none;"
            >
              <rect x="6" y="4" width="4" height="16"></rect>
              <rect x="14" y="4" width="4" height="16"></rect>
            </svg>
          </button>

          <div class="producer-info">
            <h4 id="audioProducerName">Andrés Pineda</h4>
            <p class="brand" id="audioBrand">Café Montepineda</p>
            <p class="location" id="audioLocation">Pradera, Valle del Cauca</p>
          </div>
        </div>
      </div>

      <div class="player-right">
        <div class="timeline">
          <input
            type="range"
            min="0"
            max="110"
            value="0"
            class="progress-bar"
            id="audioProgress"
          />
          <div class="timestamps">
            <span id="currentTime">00:00</span>
            <span id="duration">01:50</span>
          </div>
        </div>

        <div class="subtitles-box">
          <p id="audioSubtitles">
            Subtítulos: Lorem ipsum dolor sit amet, consectetuer adipiscing
            elit, sed diam nonummy nibh euismod tincidunt ut laoreet
          </p>
        </div>

        <div class="nav-controls">
          <button class="nav-btn nav-prev" id="prevAudioBtn" aria-label="Anterior audio">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><polyline points="15 18 9 12 15 6"></polyline></svg
            >
          </button>
          <button class="nav-btn nav-next" id="nextAudioBtn" aria-label="Siguiente audio">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><polyline points="9 18 15 12 9 6"></polyline></svg
            >
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Elemento de audio nativo oculto -->
  <audio id="audioElement" preload="metadata"></audio>
</section>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  .corazon-campo {
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
    width: 100%;
    padding-block: var(--space-6, 1.5rem);
    font-family: var(--font-komet);
  }

  .audio-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
  }

  .header-left h2 {
    color: var(--color-nav-text, #32509d);
    font-size: 2.2rem;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-heavy, 800);
  }

  .header-left h2 .highlight {
    display: block;
    font-size: 1.6rem;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-bold, 700);
    text-transform: none;
  }

  .header-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-5, 1.25rem);
    color: var(--color-nav-text, #32509d);
    font-size: 1.1rem;
    line-height: 1.6;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
  }

  .header-right p {
    margin: 0;
    line-height: 1.6;
  }

  .header-right strong {
    font-weight: var(--font-weight-komet-bold, 700);
  }

  .audio-player-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .audio-player-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
    background-color: transparent;
  }

  .player-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-6, 1.5rem);
    align-items: flex-start;
  }

  .producer-info-container {
    display: flex;
    align-items: center;
    gap: var(--space-4, 1rem);
  }

  .play-pause-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: none;
    background: var(--color-nav-text, #32509d);
    color: var(--color-surface, #ffffff);
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .play-pause-btn:hover {
    transform: scale(1.05);
    opacity: 0.9;
  }

  .play-pause-btn.playing .icon-play {
    display: none;
  }

  .play-pause-btn.playing .icon-pause {
    display: block;
  }

  .producer-info {
    display: flex;
    flex-direction: column;
    color: var(--color-nav-text, #32509d);
    font-family: var(--font-komet);
  }

  .producer-info h4 {
    font-size: 1.1rem;
    font-weight: var(--font-weight-komet-bold, 700);
    margin: 0;
    line-height: 1.3;
  }

  .producer-info .brand {
    font-size: 1rem;
    font-weight: var(--font-weight-komet-bold, 700);
    margin: 0 0 2px 0;
  }

  .producer-info .location {
    font-size: 0.9rem;
    font-weight: var(--font-weight-komet-light, 300);
    margin: 0;
    opacity: 0.85;
  }

  .player-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    width: 100%;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .progress-bar {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    background: var(--color-nav-text, #32509d);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }

  .progress-bar::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-nav-text, #32509d);
    cursor: pointer;
    transition: transform 0.1s;
  }

  .progress-bar::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-nav-text, #32509d);
    cursor: pointer;
    border: none;
  }

  .timestamps {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
    color: var(--color-nav-text, #32509d);
  }

  .subtitles-box {
    color: var(--color-nav-text, #32509d);
    font-family: var(--font-komet);
  }

  .subtitles-box p {
    font-size: 1rem;
    font-weight: var(--font-weight-komet-light, 300);
    margin: 0;
    line-height: 1.6;
  }

  .nav-controls {
    display: flex;
    gap: var(--space-3, 0.75rem);
    align-items: center;
    margin-top: var(--space-2, 0.5rem);
  }

  .nav-btn {
    background-color: var(--color-nav-text, #32509d);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-surface, #ffffff);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nav-btn:hover {
    opacity: 0.85;
    transform: scale(1.08);
  }

  /* =========================================
     BREAKPOINT 850px
     ========================================= */
  @media (min-width: 850px) {
    .corazon-campo {
      padding-block: var(--space-8, 2rem);
    }

    .audio-header {
      display: grid;
      grid-template-columns: 380px 1fr;
      align-items: flex-start;
      gap: var(--space-8, 2rem);
    }

    .header-left {
      max-width: 100%;
    }

    .header-left h2 {
      font-size: 3rem;
    }

    .header-left h2 .highlight {
      font-size: 2rem;
    }

    .header-right {
      max-width: 100%;
    }

    .audio-player-card {
      display: grid;
      grid-template-columns: 380px 1fr;
      align-items: flex-start;
      gap: var(--space-8, 2rem);
    }

    .player-left {
      flex-direction: column;
      align-items: flex-start;
    }

    .player-right {
      flex: 1;
    }
  }

  /* =========================================
     BREAKPOINT 360px
     ========================================= */
</style>

<script>
  // Script interactivo para el reproductor y carrusel de relatos sonoros (4 tracks mock)
  document.addEventListener("DOMContentLoaded", () => {
    const tracks = [
      {
        producer: "Andrés Pineda",
        brand: "Café Montepineda",
        location: "Pradera, Valle del Cauca",
        duration: "01:50",
        seconds: 110,
        subtitles: "Subtítulos: Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet",
      },
      {
        producer: "María del Carmen Valencia",
        brand: "Cacao La Esperanza",
        location: "Tumaco, Nariño",
        duration: "02:15",
        seconds: 135,
        subtitles: "Subtítulos: El cacao nos devolvió la paz a nuestra vereda. Cuando sembramos el primer árbol, supimos que el futuro de nuestros hijos cambiaría para siempre.",
      },
      {
        producer: "José Roberto Muelas",
        brand: "Miel Silvestre PDET",
        location: "La Montañita, Caquetá",
        duration: "01:35",
        seconds: 95,
        subtitles: "Subtítulos: Las abejas no solo producen la mejor miel, cuidan el bosque amazónico y nos enseñan a trabajar en comunidad por la conservación de nuestro territorio.",
      },
      {
        producer: "Esperanza Gómez",
        brand: "Artesanías Tejidos de Paz",
        location: "San Jacinto, Bolívar",
        duration: "02:05",
        seconds: 125,
        subtitles: "Subtítulos: En cada hilo de nuestras hamacas tejemos la historia de resiliencia y el orgullo artesanal de las mujeres de los Montes de María.",
      }
    ];

    let currentTrackIndex = 0;
    let isPlaying = false;
    let mockInterval: any = null;

    const playBtn = document.getElementById("playPauseBtn");
    const prevBtn = document.getElementById("prevAudioBtn");
    const nextBtn = document.getElementById("nextAudioBtn");
    const progressBar = document.getElementById("audioProgress") as HTMLInputElement;
    const currentTimeEl = document.getElementById("currentTime");
    const durationEl = document.getElementById("duration");
    const producerNameEl = document.getElementById("audioProducerName");
    const brandEl = document.getElementById("audioBrand");
    const locationEl = document.getElementById("audioLocation");
    const subtitlesEl = document.getElementById("audioSubtitles");
    const audioElement = document.getElementById("audioElement") as HTMLAudioElement;

    function formatTime(seconds: number): string {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins < 10 ? '0' : ''}${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    function stopPlayback() {
      isPlaying = false;
      playBtn?.classList.remove("playing");
      if (mockInterval) clearInterval(mockInterval);
      if (audioElement && audioElement.src && audioElement.src !== window.location.href) {
        audioElement.pause();
      }
    }

    function loadTrack(index: number) {
      stopPlayback();
      currentTrackIndex = index;
      const track = tracks[currentTrackIndex];

      if (producerNameEl) producerNameEl.textContent = track.producer;
      if (brandEl) brandEl.textContent = track.brand;
      if (locationEl) locationEl.textContent = track.location;
      if (durationEl) durationEl.textContent = track.duration;
      if (subtitlesEl) subtitlesEl.textContent = track.subtitles;

      if (progressBar) {
        progressBar.max = track.seconds.toString();
        progressBar.value = "0";
      }
      if (currentTimeEl) currentTimeEl.textContent = "00:00";
    }

    if (playBtn && progressBar) {
      playBtn.addEventListener("click", () => {
        isPlaying = !isPlaying;

        if (isPlaying) {
          playBtn.classList.add("playing");
          if (!audioElement.src || audioElement.src === window.location.href) {
            mockInterval = setInterval(() => {
              let val = parseInt(progressBar.value);
              const maxVal = parseInt(progressBar.max);
              if (val < maxVal) {
                val += 1;
                progressBar.value = val.toString();
                if (currentTimeEl) currentTimeEl.textContent = formatTime(val);
              } else {
                stopPlayback();
                progressBar.value = "0";
                if (currentTimeEl) currentTimeEl.textContent = "00:00";
              }
            }, 1000);
          } else {
            audioElement.play();
          }
        } else {
          stopPlayback();
        }
      });

      progressBar.addEventListener("input", () => {
        const val = parseInt(progressBar.value);
        if (currentTimeEl) currentTimeEl.textContent = formatTime(val);
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        const nextIndex = (currentTrackIndex - 1 + tracks.length) % tracks.length;
        loadTrack(nextIndex);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        const nextIndex = (currentTrackIndex + 1) % tracks.length;
        loadTrack(nextIndex);
      });
    }

    // Cargar pista inicial
    loadTrack(0);
  });
</script>
