---
// Sección 4 · Mockup: documentacion/seccion4@2x-100.jpg
// "El corazón del campo": reproductor de relatos sonoros. Card con botón de
// micrófono, datos del productor (nombre, marca, municipio), barra de progreso
// con timestamps y caja de subtítulos. Flechas para pasar de un audio a otro.
// Usar <audio> + <input type="range"> nativos, sin librería.
---

<section class="corazon-campo">
  <div class="audio-header">
    <div class="header-left">
      <h2>EL CORAZÓN<br/>DEL CAMPO:<br/><span class="highlight">La voz del territorio</span></h2>
    </div>
    <div class="header-right">
      <p>Nadie narra la transformación mejor que quienes la viven día a día en el surco, la parcela o el taller. <strong>Te invitamos a cerrar los ojos y escuchar estos relatos sonoros grabados directamente en el territorio.</strong></p>
      <p>En sus propias voces, las y los productores nos comparten sus memorias, sus sueños y la emoción de ver cómo el trabajo de la tierra está transformando el futuro de sus familias.</p>
    </div>
  </div>

  <div class="audio-player-wrapper">
    <div class="audio-player-card">
      <div class="player-left">
        <div class="producer-info-container">
          <button class="play-pause-btn" aria-label="Reproducir audio" id="playPauseBtn">
            <!-- Icono de Play -->
            <svg class="icon-play" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <!-- Icono de Pause -->
            <svg class="icon-pause" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="display: none;">
              <rect x="6" y="4" width="4" height="16"></rect>
              <rect x="14" y="4" width="4" height="16"></rect>
            </svg>
          </button>
          
          <div class="producer-info">
            <h4>Andrés Pineda</h4>
            <p class="brand">Café Montepineda</p>
            <p class="location">Pradera, Valle del Cauca</p>
          </div>
        </div>
        
        <div class="nav-controls">
          <button class="nav-btn nav-prev" aria-label="Anterior audio">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button class="nav-btn nav-next" aria-label="Siguiente audio">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="player-right">
        <div class="timeline">
          <input type="range" min="0" max="110" value="0" class="progress-bar" id="audioProgress" />
          <div class="timestamps">
            <span id="currentTime">00:00</span>
            <span id="duration">01:50</span>
          </div>
        </div>
        <div class="subtitles-box">
          <p>Subtítulos: Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet</p>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Elemento de audio nativo oculto -->
  <audio id="audioElement" preload="metadata">
    <!-- <source src="/audio/ejemplo.mp3" type="audio/mpeg"> -->
  </audio>
</section>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  .corazon-campo {
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-6, 1.5rem);
    font-family: var(--font-monique-regular, sans-serif);
  }

  .audio-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-6, 1.5rem);
    margin-bottom: var(--space-2, 0.5rem);
  }

  .header-left h2 {
    color: var(--color-nav-text, #32509d);
    font-size: 2.2rem;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
    font-weight: var(--font-weight-komet-heavy, 800);
  }

  .header-left h2 .highlight {
    display: block;
    font-size: 1.6rem;
    font-weight: bold;
    text-transform: none;
  }

  .header-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    color: var(--color-nav-text, #32509d);
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .header-right p {
    margin: 0;
  }

  .audio-player-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .audio-player-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
    background-color: transparent;
  }

  .player-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-6, 1.5rem);
    align-items: center;
  }

  .producer-info-container {
    display: flex;
    align-items: center;
    gap: var(--space-4, 1rem);
  }

  .play-pause-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: none;
    background: var(--color-nav-text, #32509d);
    color: var(--color-surface, #ffffff);
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .play-pause-btn:hover {
    transform: scale(1.05);
    opacity: 0.9;
  }

  .play-pause-btn.playing .icon-play {
    display: none;
  }

  .play-pause-btn.playing .icon-pause {
    display: block !important;
  }

  .producer-info {
    display: flex;
    flex-direction: column;
    color: var(--color-nav-text, #32509d);
  }

  .producer-info h4 {
    font-size: 1.1rem;
    font-weight: bold;
    margin: 0;
    line-height: 1.2;
  }

  .producer-info .brand {
    font-size: 1rem;
    font-weight: bold;
    margin: 0 0 2px 0;
  }

  .producer-info .location {
    font-size: 0.9rem;
    margin: 0;
    opacity: 0.8;
  }

  .nav-controls {
    display: flex;
    gap: var(--space-4, 1rem);
    justify-content: center;
  }

  .nav-btn {
    background-color: var(--color-nav-text, #32509d);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-surface, #ffffff);
    transition: opacity 0.2s ease;
  }

  .nav-btn:hover {
    opacity: 0.8;
  }

  .player-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    width: 100%;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .progress-bar {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    background: var(--color-nav-text, #32509d);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }

  .progress-bar::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-nav-text, #32509d);
    cursor: pointer;
    transition: transform 0.1s;
  }

  .progress-bar::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-nav-text, #32509d);
    cursor: pointer;
    border: none;
  }

  .timestamps {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--color-nav-text, #32509d);
  }

  .subtitles-box {
    color: var(--color-nav-text, #32509d);
  }

  .subtitles-box p {
    font-size: 1rem;
    margin: 0;
    line-height: 1.5;
  }

  /* =========================================
     BREAKPOINT 768px
     ========================================= */
  @media (min-width: 768px) {
    .audio-header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-8, 2rem);
    }
    
    .header-left {
      flex: 1;
      max-width: 40%;
    }

    .header-left h2 {
      font-size: 3rem;
    }

    .header-left h2 .highlight {
      font-size: 2rem;
    }

    .header-right {
      flex: 1;
      max-width: 55%;
    }

    .audio-player-card {
      flex-direction: row;
      align-items: center;
      gap: var(--space-12, 3rem);
    }

    .player-left {
      flex-direction: column;
      align-items: center;
      min-width: 300px;
    }

    .nav-controls {
      align-self: center;
    }

    .player-right {
      flex: 1;
    }
  }

  /* =========================================
     BREAKPOINT 1024px
     ========================================= */
  @media (min-width: 1024px) {
    .corazon-campo {
      padding: var(--space-8, 2rem);
    }
  }
</style>

<script>
  // Script para manejar el reproductor de audio (mock)
  document.addEventListener("DOMContentLoaded", () => {
    const playBtn = document.getElementById("playPauseBtn");
    const progressBar = document.getElementById(
      "audioProgress",
    ) as HTMLInputElement;
    const audioElement = document.getElementById(
      "audioElement",
    ) as HTMLAudioElement;

    let isPlaying = false;
    let mockInterval: any = null;

    if (playBtn && progressBar) {
      playBtn.addEventListener("click", () => {
        isPlaying = !isPlaying;

        if (isPlaying) {
          playBtn.classList.add("playing");
          // Simular reproducción si no hay source real
          if (!audioElement.src || audioElement.src === window.location.href) {
            mockInterval = setInterval(() => {
              let val = parseInt(progressBar.value);
              if (val < parseInt(progressBar.max)) {
                progressBar.value = (val + 1).toString();
                // Aquí se actualizaría el tiempo actual (currentTime)
              } else {
                // Termina
                clearInterval(mockInterval);
                playBtn.classList.remove("playing");
                isPlaying = false;
                progressBar.value = "0";
              }
            }, 1000);
          } else {
            audioElement.play();
          }
        } else {
          playBtn.classList.remove("playing");
          if (!audioElement.src || audioElement.src === window.location.href) {
            clearInterval(mockInterval);
          } else {
            audioElement.pause();
          }
        }
      });
    }
  });
</script>
