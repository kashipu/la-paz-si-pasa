---
// Sección 4 · Mockup: documentacion/seccion4@2x-100.jpg
// "El corazón del campo": reproductor de relatos sonoros. Card con botón de
// reproducción, datos del productor (nombre, marca, municipio), barra de progreso
// con timestamps, caja de subtítulos y flechas para pasar de un audio a otro.
// Los relatos vienen del CPT `audio_relato` vía props de la página.
import type { AudioRelato } from "@adapters/contracts";

type Props = { relatos: AudioRelato[] };
const { relatos } = Astro.props;

const inicial = relatos[0];

function formatearDuracion(segundos?: number) {
  if (!segundos || !Number.isFinite(segundos)) return "00:00";
  const minutos = Math.floor(segundos / 60);
  const resto = Math.floor(segundos % 60);
  return `${String(minutos).padStart(2, "0")}:${String(resto).padStart(2, "0")}`;
}
---

<section class="corazon-campo" id="escucha-el-corazon-del-campo" data-relatos={JSON.stringify(relatos)}>
  <div class="audio-header">
    <div class="header-left">
      <h2>
        EL CORAZÓN<br />DEL CAMPO:<br />
        <span class="highlight">La voz del territorio</span>
      </h2>
    </div>
    <div class="header-right">
      <p>
        Nadie narra la transformación mejor que quienes la viven día a día en el
        surco, la parcela o el taller. <strong>Te invitamos a cerrar los ojos y escuchar estos relatos sonoros
        grabados directamente en el territorio.</strong>
      </p>
      <p>
        En sus propias voces, las y los productores nos comparten sus memorias,
        sus sueños y la emoción de ver cómo el trabajo de la tierra está
        transformando el futuro de sus familias.
      </p>
    </div>
  </div>

  <div class="audio-player-wrapper">
    <div class="audio-player-card">
      <div class="player-left">
        <div class="producer-info-container">
          <button
            class="play-pause-btn"
            aria-label="Reproducir audio"
            id="playPauseBtn"
          >
            <!-- Icono de Play -->
            <svg
              class="icon-play"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="currentColor"
              stroke="none"
            >
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <!-- Icono de Pause -->
            <svg
              class="icon-pause"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="currentColor"
              stroke="none"
            >
              <rect x="6" y="4" width="4" height="16"></rect>
              <rect x="14" y="4" width="4" height="16"></rect>
            </svg>
          </button>

          <div class="producer-info">
            <h4 id="audioProducerName">{inicial?.productor}</h4>
            <p class="brand" id="audioBrand">{inicial?.marca}</p>
            <p class="location" id="audioLocation">{inicial?.lugar}</p>
          </div>
        </div>
      </div>

      <div class="player-right">
        <div class="timeline">
          <input
            type="range"
            min="0"
            max={inicial?.duracionSegundos ?? 0}
            value="0"
            step="1"
            class="progress-bar"
            id="audioProgress"
            aria-label="Progreso del relato"
          />
          <div class="timestamps">
            <span id="currentTime">00:00</span>
            <span id="duration">{formatearDuracion(inicial?.duracionSegundos)}</span>
          </div>
        </div>

        <div class="nav-controls">
          <button class="nav-btn nav-prev" id="prevAudioBtn" aria-label="Anterior audio">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><polyline points="15 18 9 12 15 6"></polyline></svg
            >
          </button>
          <button class="nav-btn nav-next" id="nextAudioBtn" aria-label="Siguiente audio">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><polyline points="9 18 15 12 9 6"></polyline></svg
            >
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Elemento de audio nativo oculto -->
  <audio id="audioElement" preload="metadata" src={inicial?.audioUrl || undefined}></audio>
</section>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  .corazon-campo {
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
    width: 100%;
    padding-block: var(--space-6, 1.5rem);
    font-family: var(--font-komet);
  }

  .audio-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
  }

  .header-left h2 {
    color: var(--color-nav-text, #32509d);
    font-size: 2.2rem;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
    font-family: var(--font-monique-regular);
    font-weight: 700;
  }

  .header-left h2 .highlight {
    display: block;
    font-size: 1.6rem;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-bold, 700);
    text-transform: none;
  }

  .header-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-5, 1.25rem);
    color: var(--color-nav-text, #32509d);
    font-size: 1.1rem;
    line-height: 1.6;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
  }

  .header-right p {
    margin: 0;
    line-height: 1.6;
  }

  .header-right strong {
    font-weight: var(--font-weight-komet-bold, 700);
  }

  .audio-player-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .audio-player-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
    background-color: transparent;
  }

  .player-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-6, 1.5rem);
    align-items: flex-start;
  }

  .producer-info-container {
    display: flex;
    align-items: center;
    gap: var(--space-4, 1rem);
  }

  .play-pause-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: none;
    background: var(--color-nav-text, #32509d);
    color: var(--color-surface, #ffffff);
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .play-pause-btn:hover {
    transform: scale(1.05);
    opacity: 0.9;
  }

  .play-pause-btn[disabled] {
    cursor: not-allowed;
    opacity: 0.45;
    transform: none;
  }

  .icon-pause {
    display: none;
  }

  .play-pause-btn.playing .icon-play {
    display: none;
  }

  .play-pause-btn.playing .icon-pause {
    display: block;
  }

  .producer-info {
    display: flex;
    flex-direction: column;
    color: var(--color-nav-text, #32509d);
    font-family: var(--font-komet);
  }

  .producer-info h4 {
    /* typography.css pone Monique en h1-h4 y eso gana sobre el Komet heredado del contenedor. */
    font-family: var(--font-komet);
    font-size: 1.1rem;
    font-weight: var(--font-weight-komet-bold, 700);
    margin: 0;
    line-height: 1.3;
  }

  .producer-info .brand {
    font-size: 1rem;
    font-weight: var(--font-weight-komet-bold, 700);
    margin: 0 0 2px 0;
  }

  .producer-info .location {
    font-size: 0.9rem;
    font-weight: var(--font-weight-komet-light, 300);
    margin: 0;
    opacity: 0.85;
  }

  .player-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    width: 100%;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .progress-bar {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    background: var(--color-nav-text, #32509d);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }

  .progress-bar::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-nav-text, #32509d);
    cursor: pointer;
    transition: transform 0.1s;
  }

  .progress-bar::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-nav-text, #32509d);
    cursor: pointer;
    border: none;
  }

  .timestamps {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    font-family: var(--font-komet);
    font-weight: var(--font-weight-komet-light, 300);
    color: var(--color-nav-text, #32509d);
  }

  .nav-controls {
    display: flex;
    gap: var(--space-3, 0.75rem);
    align-items: center;
    margin-top: var(--space-2, 0.5rem);
  }

  .nav-btn {
    background-color: var(--color-nav-text, #32509d);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-surface, #ffffff);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nav-btn:hover {
    opacity: 0.85;
    transform: scale(1.08);
  }

  /* =========================================
     BREAKPOINT 850px
     ========================================= */
  @media (min-width: 850px) {
    .corazon-campo {
      padding-block: var(--space-8, 2rem);
    }

    .audio-header {
      display: grid;
      grid-template-columns: 380px 1fr;
      align-items: flex-start;
      gap: var(--space-8, 2rem);
    }

    .header-left {
      max-width: 100%;
    }

    .header-left h2 {
      font-size: 3rem;
    }

    .header-left h2 .highlight {
      font-size: 2rem;
    }

    .header-right {
      max-width: 100%;
    }

    .audio-player-card {
      display: grid;
      grid-template-columns: 380px 1fr;
      align-items: flex-start;
      gap: var(--space-8, 2rem);
    }

    .player-left {
      flex-direction: column;
      align-items: flex-start;
    }

    .player-right {
      flex: 1;
    }
  }

  /* =========================================
     BREAKPOINT 360px
     ========================================= */
</style>

<script>
  import type { AudioRelato } from "@adapters/contracts";

  // Reproductor de relatos sonoros sobre el elemento <audio> nativo.
  // Los relatos llegan serializados en data-relatos desde la página.
  document.addEventListener("astro:page-load", () => {
    const seccion = document.getElementById("escucha-el-corazon-del-campo");
    if (!seccion) return;

    const relatos: AudioRelato[] = JSON.parse(seccion.dataset.relatos || "[]");
    if (relatos.length === 0) return;

    const playBtn = document.getElementById("playPauseBtn");
    const prevBtn = document.getElementById("prevAudioBtn");
    const nextBtn = document.getElementById("nextAudioBtn");
    const progressBar = document.getElementById("audioProgress") as HTMLInputElement;
    const currentTimeEl = document.getElementById("currentTime");
    const durationEl = document.getElementById("duration");
    const producerNameEl = document.getElementById("audioProducerName");
    const brandEl = document.getElementById("audioBrand");
    const locationEl = document.getElementById("audioLocation");
    const audio = document.getElementById("audioElement") as HTMLAudioElement;
    if (!audio || !playBtn || !progressBar) return;

    let indiceActual = 0;

    function formatTime(seconds: number): string {
      if (!Number.isFinite(seconds)) return "00:00";
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins < 10 ? "0" : ""}${mins}:${secs < 10 ? "0" : ""}${secs}`;
    }

    function pintarDuracion(segundos: number) {
      if (durationEl) durationEl.textContent = formatTime(segundos);
      progressBar.max = String(Math.floor(segundos) || 0);
    }

    function cargarRelato(indice: number) {
      audio.pause();
      playBtn.classList.remove("playing");
      indiceActual = indice;
      const relato = relatos[indiceActual];

      if (producerNameEl) producerNameEl.textContent = relato.productor;
      if (brandEl) brandEl.textContent = relato.marca;
      if (locationEl) locationEl.textContent = relato.lugar;

      progressBar.value = "0";
      if (currentTimeEl) currentTimeEl.textContent = "00:00";
      pintarDuracion(relato.duracionSegundos ?? 0);

      // Sin archivo publicado en WordPress: controles deshabilitados, sin aviso visible.
      const disponible = Boolean(relato.audioUrl);
      playBtn?.setAttribute("aria-label", disponible ? "Reproducir audio" : "Audio no disponible");
      playBtn?.toggleAttribute("disabled", !disponible);
      progressBar.toggleAttribute("disabled", !disponible);

      if (disponible) audio.src = relato.audioUrl;
      else audio.removeAttribute("src");
    }

    playBtn.addEventListener("click", () => {
      if (audio.paused) audio.play();
      else audio.pause();
    });

    audio.addEventListener("play", () => playBtn.classList.add("playing"));
    audio.addEventListener("pause", () => playBtn.classList.remove("playing"));

    // La duración real del archivo manda sobre la que se cargó en WordPress.
    audio.addEventListener("loadedmetadata", () => pintarDuracion(audio.duration));

    audio.addEventListener("timeupdate", () => {
      progressBar.value = String(audio.currentTime);
      if (currentTimeEl) currentTimeEl.textContent = formatTime(audio.currentTime);
    });

    audio.addEventListener("ended", () => {
      progressBar.value = "0";
      if (currentTimeEl) currentTimeEl.textContent = "00:00";
    });

    progressBar.addEventListener("input", () => {
      const valor = Number(progressBar.value);
      audio.currentTime = valor;
      if (currentTimeEl) currentTimeEl.textContent = formatTime(valor);
    });

    prevBtn?.addEventListener("click", () => {
      cargarRelato((indiceActual - 1 + relatos.length) % relatos.length);
    });

    nextBtn?.addEventListener("click", () => {
      cargarRelato((indiceActual + 1) % relatos.length);
    });

    cargarRelato(0);
  });
</script>
