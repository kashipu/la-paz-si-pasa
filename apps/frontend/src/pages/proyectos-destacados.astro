---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaisSanaHero from "../components/paisana/PaisSanaHero.astro";
import PaisSanaMapaIntro from "../components/paisana/PaisSanaMapaIntro.astro";
import PaisSanaMapaCarrusel from "../components/paisana/PaisSanaMapaCarrusel.astro";
import PaisSanaAudioPlayer from "../components/paisana/PaisSanaAudioPlayer.astro";
import PaisSanaFeriasIntro from "../components/paisana/PaisSanaFeriasIntro.astro";
import PaisSanaFeriasAcordeon from "../components/paisana/PaisSanaFeriasAcordeon.astro";
import PaisSanaProductoresVideos from "../components/paisana/PaisSanaProductoresVideos.astro";
import ProyectosNav from "../components/ProyectosNav.astro";
import Hero from "../components/Hero.astro";
import { checkWordPressConnection, getAudioRelatos, getFerias, getHome, getVideos } from "../adapters";
import type { ContentSourceStatus } from "../adapters";

const dataSources = new Map<string, ContentSourceStatus["source"]>();
const debugParam = Astro.url.searchParams.get("debug-content");
const contentDebugEnabled = debugParam === "1" || (import.meta.env.DEV && debugParam !== "0");
const reportContentSource = contentDebugEnabled
  ? (status: ContentSourceStatus) => dataSources.set(status.content, status.source)
  : undefined;
const [home, audioRelatos, ferias, videos, wordpressStatus] = await Promise.all([
  getHome(reportContentSource),
  getAudioRelatos(reportContentSource),
  getFerias(reportContentSource),
  getVideos(reportContentSource),
  contentDebugEnabled ? checkWordPressConnection() : Promise.resolve(undefined),
]);

// Productores PaisSana reutiliza el CPT `video`, filtrado por la etiqueta del sello.
const productores = videos.filter((video) => video.tags.includes("PaisSana"));

const fuente = (clave: string) => dataSources.get(clave) ?? "mocks";
const contentSources: ContentSourceStatus[] = contentDebugEnabled ? [
  { content: "Página proyectos-destacados.astro", source: "code" },
  { content: "Hero.astro", source: fuente("home") },
  { content: "ProyectosNav", source: "code" },
  { content: "PaisSanaAudioPlayer.astro", source: fuente("audioRelatos") },
  { content: "PaisSanaProductoresVideos.astro", source: fuente("videos") },
  { content: "PaisSanaFeriasIntro", source: "code" },
  { content: "PaisSanaFeriasAcordeon", source: fuente("ferias") },
  { content: "PaisSanaFeriaItem", source: fuente("ferias") },
] : [];
---

<BaseLayout
  title="Proyectos destacados - PaisSana"
  contentSources={contentSources}
  wordpressStatus={wordpressStatus}
>
  <Hero slot="hero" hero={home.hero} />
  <div class="paisana-page container--wide">
    <div class="paisana-header">
      <ProyectosNav />
      <PaisSanaHero />
    </div>

    <PaisSanaMapaIntro />
    <PaisSanaMapaCarrusel />
    <PaisSanaAudioPlayer relatos={audioRelatos} />
    <PaisSanaProductoresVideos videos={productores} />
    <PaisSanaFeriasIntro />
    <PaisSanaFeriasAcordeon ferias={ferias} />
  </div>
</BaseLayout>

<style>
  /* =========================================
     CSS GENERAL
     ========================================= */
  .paisana-page {
    display: flex;
    flex-direction: column;
    padding-block: 0 10rem;
    gap: 10rem;
  }

  .paisana-header {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  /* =========================================
     BREAKPOINT 850px
     ========================================= */

  /* =========================================
     BREAKPOINT 360px
     ========================================= */
</style>

<style is:global>
  /* =========================================
     GLOBAL TYPOGRAPHY PARA COMPONENTES PAISSANA
     ========================================= */
  .paisana-page {
    font-family: var(--font-komet);
    color: var(--color-nav-text);
  }

  .paisana-page h1,
  .paisana-page h2,
  .paisana-page h3 {
    font-family: var(--font-monique-regular);
    font-weight: 400;
    color: var(--color-nav-text);
    line-height: 1.15;
  }

  .paisana-page h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .paisana-page h3 {
    font-size: clamp(1.25rem, 2.5vw, 1.85rem);
  }

  .paisana-page p,
  .paisana-page li,
  .paisana-page .text {
    font-family: var(--font-komet);
    font-size: clamp(1rem, 2vw, 1.125rem);
    font-weight: var(--font-weight-komet-light, 300);
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: var(--color-nav-text);
  }

  .paisana-page strong {
    font-weight: var(--font-weight-komet-heavy, 800);
  }
</style>
