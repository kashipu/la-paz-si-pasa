---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de dirección. Vuelve al inicio para conocer la gestión del Fondo Colombia en Paz en los territorios."
>
  <section class="not-found">
    <div>
      <h1>Página no encontrada</h1>
      <p>El contenido solicitado no existe o cambió de dirección.</p>
      <a href="/">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 50vh;
    display: grid;
    place-items: center;
    padding: var(--space-16) var(--space-4);
    text-align: center;
  }

  .not-found div {
    display: grid;
    gap: var(--space-4);
  }
</style>
