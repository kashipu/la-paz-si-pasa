{
  "key": "group_videos_lapazsipasa",
  "title": "Datos del video",
  "fields": [
    {
      "key": "field_video_descripcion",
      "label": "Descripción",
      "name": "descripcion",
      "aria-label": "",
      "type": "textarea",
      "instructions": "Texto que acompaña al video en la galería. Máximo 500 caracteres.",
      "required": 1,
      "conditional_logic": false,
      "wrapper": { "width": "", "class": "", "id": "" },
      "default_value": "",
      "maxlength": 500,
      "rows": 4,
      "placeholder": "",
      "new_lines": "br"
    },
    {
      "key": "field_video_fuente",
      "label": "Fuente del video",
      "name": "fuente_video",
      "aria-label": "",
      "type": "select",
      "instructions": "Elige de dónde viene el video. Solo se pedirá el campo correspondiente.",
      "required": 1,
      "conditional_logic": false,
      "wrapper": { "width": "", "class": "", "id": "" },
      "choices": { "youtube": "YouTube", "wordpress": "Archivo MP4 subido a WordPress" },
      "default_value": "youtube",
      "allow_null": 0,
      "multiple": 0,
      "ui": 0,
      "return_format": "value",
      "ajax": 0,
      "placeholder": "",
      "create_options": 0,
      "save_options": 0
    },
    {
      "key": "field_video_youtube_url",
      "label": "URL de YouTube",
      "name": "youtube_url",
      "aria-label": "",
      "type": "url",
      "instructions": "Pega la URL normal del video. Se convierte a embed sin cookies automáticamente.",
      "required": 1,
      "conditional_logic": [[{ "field": "field_video_fuente", "operator": "==", "value": "youtube" }]],
      "wrapper": { "width": "", "class": "", "id": "" },
      "default_value": "",
      "placeholder": "https://www.youtube.com/watch?v="
    },
    {
      "key": "field_video_file",
      "label": "Archivo de video (MP4)",
      "name": "video_file",
      "aria-label": "",
      "type": "file",
      "instructions": "Sube el MP4 ya comprimido. Evita archivos de más de 50 MB.",
      "required": 1,
      "conditional_logic": [[{ "field": "field_video_fuente", "operator": "==", "value": "wordpress" }]],
      "wrapper": { "width": "", "class": "", "id": "" },
      "return_format": "array",
      "library": "all",
      "mime_types": "mp4"
    },
    {
      "key": "field_video_thumbnail",
      "label": "Miniatura",
      "name": "thumbnail",
      "aria-label": "",
      "type": "image",
      "instructions": "Obligatoria para MP4. En YouTube se usa la miniatura del video si se deja vacía.",
      "required": 0,
      "conditional_logic": false,
      "wrapper": { "width": "", "class": "", "id": "" },
      "return_format": "array",
      "library": "all",
      "preview_size": "medium"
    },
    {
      "key": "field_video_tags",
      "label": "Etiquetas",
      "name": "tags",
      "aria-label": "",
      "type": "select",
      "instructions": "Elige 1 o 2. «PaisSana» hace que el video aparezca en Productores PaisSana.",
      "required": 1,
      "conditional_logic": false,
      "wrapper": { "width": "", "class": "", "id": "" },
      "choices": {
        "PaisSana": "PaisSana",
        "Colombia Sostenible": "Colombia Sostenible",
        "PDET": "PDET",
        "Actualidad": "Actualidad"
      },
      "default_value": "",
      "allow_null": 0,
      "multiple": 1,
      "ui": 1,
      "return_format": "value",
      "ajax": 0,
      "placeholder": "",
      "create_options": 0,
      "save_options": 0
    }
  ],
  "location": [[{ "param": "post_type", "operator": "==", "value": "video" }]],
  "menu_order": 0,
  "position": "normal",
  "style": "default",
  "label_placement": "top",
  "instruction_placement": "label",
  "hide_on_screen": [],
  "active": true,
  "description": "Campos de la galería de Actualidad y de Productores PaisSana.",
  "show_in_rest": 1
}
